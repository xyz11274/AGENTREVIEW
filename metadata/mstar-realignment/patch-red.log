        selection = atomic_write_json(reference_root / "selection.json", dict.fromkeys(ids, "Reviewer 1"))
        reference = atomic_write_json(reference_root / "references.json", {"protocol": coco.REFERENCE_MANIFEST_PROTOCOL,
