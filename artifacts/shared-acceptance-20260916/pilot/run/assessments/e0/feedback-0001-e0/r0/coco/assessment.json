              "raw_response": "\n\n{\n  \"claim_extraction\": \"claim\",\n  \"actionability\": 5,\n  \"grounding_specificity\": 5,\n  \"verifiability\": 3,\n  \"alignment\": 3,\n  \"completeness\": 1,\n  \"clarity\": 4\n}",
              "success": true,
