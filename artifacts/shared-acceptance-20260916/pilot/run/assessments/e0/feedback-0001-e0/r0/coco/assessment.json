              "raw_response": "\n\n{\n  \"claim_extraction\": \"normal\",\n  \"actionability\": \"X\",\n  \"grounding_specificity\": 2,\n  \"verifiability\": \"X\",\n  \"alignment\": 3,\n  \"completeness\": 1,\n  \"clarity\": 5\n}",
