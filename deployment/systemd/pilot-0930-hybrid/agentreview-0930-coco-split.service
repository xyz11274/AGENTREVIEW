[Unit]
Description=agentreview-0930-coco-split
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=/data0/xyj/shengao/agentreview-0930-coco
StandardInput=null
StandardOutput=append:/data0/xyj/shengao/agentreview-0930-coco/split.systemd.log
StandardError=append:/data0/xyj/shengao/agentreview-0930-coco/split.systemd.log
Restart=always
RestartSec=30
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=90
Environment="CUDA_VISIBLE_DEVICES=5"
Environment="PATH=/data0/xyj/miniconda3/envs/qwen38serve/bin:/usr/local/bin:/usr/bin:/bin"
Environment="NO_PROXY=127.0.0.1,localhost,::1"
Environment="no_proxy=127.0.0.1,localhost,::1"
ExecStartPre="/usr/bin/python3" "-c" "import subprocess; rows=subprocess.check_output([\"nvidia-smi\",\"--id=5\",\"--query-gpu=memory.free,memory.total\",\"--format=csv,noheader,nounits\"],text=True); values=[tuple(map(float,s.split(\",\"))) for s in rows.splitlines()]; assert len(values)==1 and all(f>=t*0.8 for f,t in values), \"Insufficient free GPU memory; retry without stopping any existing job\""
ExecStart="/data0/xyj/miniconda3/envs/qwen38serve/bin/python" "-m" "vllm.entrypoints.openai.api_server" "--model" "/data0/xyj/shengao/CoCoReviewBench/model/split_model" "--served-model-name" "Qwen3-8B-Split" "--host" "127.0.0.1" "--port" "13099" "--dtype" "bfloat16" "--tensor-parallel-size" "1" "--max-model-len" "65536" "--gpu-memory-utilization" "0.8" "--max-num-seqs" "8" "--max-num-batched-tokens" "2048" "--enable-chunked-prefill" "--enable-prefix-caching" "--hf-overrides" "{\"rope_scaling\": {\"rope_type\": \"yarn\", \"factor\": 4.0, \"original_max_position_embeddings\": 32768}}"

[Install]
WantedBy=default.target
